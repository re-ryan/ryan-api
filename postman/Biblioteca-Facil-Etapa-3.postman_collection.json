{
  "info": {
    "name": "Biblioteca Fácil - Etapa 3",
    "description": "Requisições principais da API REST. Execute as requisições de cada pasta na ordem apresentada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"}
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const esperado = Number(pm.info.requestName.match(/\\((\\d{3})\\)$/)?.[1]);",
          "if (esperado) pm.test(`Status ${esperado}`, () => pm.response.to.have.status(esperado));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Autores",
      "item": [
        {
          "name": "Incluir autor (201)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"id\": 101,\n  \"nome\": \"Conceição Evaristo\",\n  \"nomeCatalogacao\": \"EVARISTO, Conceição\"\n}"},
            "url": "{{baseUrl}}/api/autores"
          }
        },
        {"name": "Obter autor por ID (200)", "request": {"method": "GET", "url": "{{baseUrl}}/api/autores/101"}},
        {
          "name": "Alterar autor (200)",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Conceição Evaristo\",\n  \"nomeCatalogacao\": \"EVARISTO, Conceição - revisado\"\n}"},
            "url": "{{baseUrl}}/api/autores/101"
          }
        },
        {"name": "Listar autores (200)", "request": {"method": "GET", "url": "{{baseUrl}}/api/autores"}},
        {"name": "Excluir autor (204)", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/autores/101"}}
      ]
    },
